# Copy to .env and fill in. Never commit the real .env.

# ── Core ─────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/
SECRET_KEY=change-me-flask-session-and-csrf-key
FLASK_DEBUG=0

# ── Third-party APIs ─────────────────────────────────────────────────────────
OCR_API_KEY=
GROQ_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender for the existing WhatsApp alerts; also the SMS sender if TWILIO_SMS_FROM is empty.
TWILIO_PHONE_NUMBER=

# ── Feature 1: passenger OTP authentication ──────────────────────────────────
# Signs passenger session cookies and keys the OTP hash. >= 32 random chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random per-process secret is used (sessions die on restart).
SIGNING_SECRET=

OTP_TTL_SECONDS=300                      # OTP validity (60-900)
OTP_MAX_ATTEMPTS=3                       # wrong attempts before lock
OTP_COOLDOWN_MINUTES=15                  # lock duration after max attempts
OTP_RESEND_SECONDS=30                    # min gap between OTP requests (per PNR + phone)
OTP_MAX_REQUESTS_PER_PNR_PER_HOUR=5      # sliding 1-hour cap per PNR
OTP_IP_REQUEST_LIMIT=20                  # OTP requests per IP per window
OTP_IP_VERIFY_LIMIT=30                   # verify attempts per IP per window
OTP_IP_WINDOW_SECONDS=3600
OTP_RECORD_RETENTION_HOURS=24            # TTL purge of OTP/session/rate-limit records

SESSION_TTL=1800                         # passenger session lifetime, seconds
PASSENGER_COOKIE_SECURE=1                # keep 1; browsers accept Secure cookies on http://localhost
PASSENGER_COOKIE_SAMESITE=Lax            # Lax | Strict | None (None requires Secure)

BOOKING_ACCESS_WINDOW_DAYS=90            # journeys older than this cannot log in

# SMS provider: mock (console + sms_log collection) | twilio
SMS_PROVIDER=mock
# Twilio SMS sender (E.164). Falls back to TWILIO_PHONE_NUMBER.
TWILIO_SMS_FROM=
# DEV ONLY: write the raw OTP into the mock SMS log/console. Leave 0 anywhere real.
SMS_MOCK_EXPOSE_OTP=0

# ── Feature 2: automatic match notification ──────────────────────────────────
MATCH_AUTO_NOTIFY_MIN=0.85               # >= this confidence: notify automatically
MATCH_REVIEW_MIN=0.60                    # >= this (and < auto): staff review first; below: rejected
MATCH_HOLD_DAYS=7                        # hold from notifiedAt, then the match is released

NOTIFY_MAX_ATTEMPTS=4                    # per channel (1-5)
NOTIFY_BACKOFF_BASE_SECONDS=30           # retry n waits base * 2^(n-1)
NOTIFY_BACKOFF_MAX_SECONDS=1800
NOTIFY_LEASE_SECONDS=120                 # a crashed worker's job is retried after this
NOTIFY_WORKER_ENABLED=1                  # in-app background worker (0 = use manage_matches.py from cron)
NOTIFY_WORKER_INTERVAL_SECONDS=15

# Base URL used in the login-protected deep link inside messages.
APP_BASE_URL=http://127.0.0.1:5003

# WhatsApp: mock (console + message_log) | twilio (uses TWILIO_* above) | meta (WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=mock
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v19.0

# Email: mock (console + message_log) | smtp
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# DEV ONLY: make the mock channels fail, to watch retries/fallback. none | transient | permanent
MOCK_WHATSAPP_FAILURE=none
MOCK_EMAIL_FAILURE=none

# ── Feature 3: secure claims and QR pickup ───────────────────────────────────
# NOTE: secret answers and pickup codes are keyed with SIGNING_SECRET — keep it stable.
TRUST_THRESHOLD=0.75                     # >= this weighted score: approved automatically
TRUST_REVIEW_MIN=0.50                    # >= this (and < threshold): follow-up question, then staff review
CLAIM_MAX_ROUNDS=3                       # question rounds before the claim locks for an ID check
CLAIM_ANSWER_MATCH_MIN=0.5               # share of an answer's words that must match
CLAIM_FUZZY_MIN_TOKEN_LENGTH=5           # words this long tolerate one typo
CLAIM_TOKEN_TTL_DAYS=7                   # pickup code validity
CLAIM_PHOTO_URL_TTL_SECONDS=120          # signed photo link lifetime
CLAIM_MAX_CLAIMS_PER_DAY=3               # per passenger
CLAIM_MAX_ANSWER_SUBMISSIONS_PER_DAY=10  # per passenger
CLAIM_IP_LIMIT=60                        # requests per IP per window on all claim/pickup endpoints
CLAIM_IP_WINDOW_SECONDS=600
